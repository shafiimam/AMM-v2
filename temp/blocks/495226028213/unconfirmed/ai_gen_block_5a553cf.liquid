{% doc %}
  @prompt
    Can you generate a section that can feature an imported image and also feature products with a heading, subheading or description 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-feature-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: #1c1c1c;
  }

  .ai-editorial-feature__layout-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(24px, 5vw, 72px);
  }

  .ai-editorial-feature__media-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    background: #f1f1f1;
  }

  .ai-editorial-feature__image-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .ai-editorial-feature__placeholder-{{ ai_gen_id }} {
    display: flex;
    width: 100%;
    aspect-ratio: 4 / 5;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
    background: #f1f1f1;
    color: #555;
    text-align: center;
  }

  .ai-editorial-feature__placeholder-{{ ai_gen_id }} svg {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 360px;
    color: #aaa;
  }

  .ai-editorial-feature__empty-{{ ai_gen_id }} {
    margin: 0;
    font-size: 14px;
  }

  .ai-editorial-feature__content-{{ ai_gen_id }} {
    min-width: 0;
  }

  .ai-editorial-feature__heading-{{ ai_gen_id }} {
    margin: 0 0 12px;
    font-family: {{ settings.heading_font.family }}, {{ settings.heading_font.fallback_families }};
    font-size: clamp(24px, 3vw, 40px);
    line-height: 1.12;
    letter-spacing: {{ settings.heading_letter_spacing }}%;
    text-transform: {{ settings.heading_text_transform }};
  }

  .ai-editorial-feature__intro-{{ ai_gen_id }} {
    margin: 0 0 28px;
    font-family: {{ settings.text_font.family }}, {{ settings.text_font.fallback_families }};
    font-size: {{ settings.text_font_size_desktop }}px;
    line-height: 1.55;
  }

  .ai-editorial-feature__products-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 16px;
  }

  .ai-editorial-feature__product-{{ ai_gen_id }} {
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .ai-editorial-feature__product-image-wrap-{{ ai_gen_id }} {
    display: block;
    overflow: hidden;
    background: #f1f1f1;
    margin-bottom: 10px;
  }

  .ai-editorial-feature__product-image-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .ai-editorial-feature__product-placeholder-{{ ai_gen_id }} svg {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 1 / 1;
    color: #aaa;
  }

  .ai-editorial-feature__product-title-{{ ai_gen_id }} {
    display: block;
    margin: 0 0 4px;
    font-size: 14px;
    line-height: 1.35;
  }

  .ai-editorial-feature__price-{{ ai_gen_id }} {
    display: block;
    font-size: 13px;
    line-height: 1.4;
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-feature-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-editorial-feature__layout-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .ai-editorial-feature__image-{{ ai_gen_id }},
    .ai-editorial-feature__placeholder-{{ ai_gen_id }} {
      aspect-ratio: 4 / 5;
    }

    .ai-editorial-feature__intro-{{ ai_gen_id }} {
      margin-bottom: 22px;
      font-size: {{ settings.text_font_size_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-editorial-feature-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-editorial-feature__layout-{{ ai_gen_id }}">
    <div class="ai-editorial-feature__media-{{ ai_gen_id }}">
      {% if block.settings.feature_image %}
        <img
          class="ai-editorial-feature__image-{{ ai_gen_id }}"
          src="{{ block.settings.feature_image | image_url: width: 1600 }}"
          alt="{{ block.settings.feature_image.alt | escape }}"
          width="{{ block.settings.feature_image.width }}"
          height="{{ block.settings.feature_image.height }}"
          loading="lazy"
        >
      {% else %}
        <div class="ai-editorial-feature__placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <p class="ai-editorial-feature__empty-{{ ai_gen_id }}">Add an image to feature your edit.</p>
        </div>
      {% endif %}
    </div>

    <div class="ai-editorial-feature__content-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-editorial-feature__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>
      {% endif %}
      {% if block.settings.description != blank %}
        <div class="ai-editorial-feature__intro-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}

      {% if block.settings.products != blank %}
        <div class="ai-editorial-feature__products-{{ ai_gen_id }}">
          {% for product in block.settings.products %}
            <a class="ai-editorial-feature__product-{{ ai_gen_id }}" href="{{ product.url }}">
              <span class="ai-editorial-feature__product-image-wrap-{{ ai_gen_id }}">
                {% if product.featured_image %}
                  <img
                    class="ai-editorial-feature__product-image-{{ ai_gen_id }}"
                    src="{{ product.featured_image | image_url: width: 700 }}"
                    alt="{{ product.featured_image.alt | default: product.title | escape }}"
                    width="{{ product.featured_image.width }}"
                    height="{{ product.featured_image.height }}"
                    loading="lazy"
                  >
                {% else %}
                  <span class="ai-editorial-feature__product-placeholder-{{ ai_gen_id }}">
                    {{ 'product-apparel-1' | placeholder_svg_tag }}
                  </span>
                {% endif %}
              </span>
              <span class="ai-editorial-feature__product-title-{{ ai_gen_id }}">{{ product.title | escape }}</span>
              {% unless settings.hide_product_price %}
                <span class="ai-editorial-feature__price-{{ ai_gen_id }}">{{ product.price | money }}</span>
              {% endunless %}
            </a>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image and products",
  "settings": [
    {
      "type": "header",
      "content": "Feature image"
    },
    {
      "type": "image_picker",
      "id": "feature_image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Feature content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The latest edit"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Subheading or description",
      "default": "<p>Discover the pieces selected for this story.</p>"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "limit": 4
    }
  ],
  "presets": [
    {
      "name": "Image and products"
    }
  ],
  "tag": null,
  "class": "image-products-block"
}
{% endschema %}