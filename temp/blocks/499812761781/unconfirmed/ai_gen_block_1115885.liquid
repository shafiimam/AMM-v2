{% doc %}
  @prompt
    can you generate a media grid section that allows for landscape shot photos to be imported and allows for the sizing of the images and the percentage of space being taken up, I need the section to be split into 4 squares. 2 on one side 2 on the other, that can hold landscape shot images. I do not want them as separate stacked images 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-media-grid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-media-grid-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: {{ block.settings.gap }}px;
    width: 100%;
  }

  .ai-media-grid-{{ ai_gen_id }}__item {
    position: relative;
    min-width: 0;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #efefef;
  }

  .ai-media-grid-{{ ai_gen_id }}__item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-media-grid-{{ ai_gen_id }}__placeholder {
    position: relative;
    display: grid;
    width: 100%;
    height: 100%;
    min-height: 0;
    place-items: center;
    background: #efefef;
  }

  .ai-media-grid-{{ ai_gen_id }}__placeholder svg {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    color: #c8c8c8;
  }

  .ai-media-grid-{{ ai_gen_id }}__empty-text {
    position: absolute;
    z-index: 1;
    right: 8px;
    bottom: 8px;
    left: 8px;
    padding: 7px 9px;
    background: rgba(255, 255, 255, 0.94);
    color: #1c1c1c;
    text-align: center;
    font-size: 13px;
  }

  @media screen and (max-width: 749px) {
    .ai-media-grid-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-media-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-media-grid-{{ ai_gen_id }}__grid">
    {% for i in (1..4) %}
      {% liquid
        assign image_key = 'image_' | append: i
        assign alt_key = 'image_' | append: i | append: '_alt'
        assign image = block.settings[image_key]
        assign image_alt = block.settings[alt_key]
      %}
      <div class="ai-media-grid-{{ ai_gen_id }}__item">
        {% if image != blank %}
          {{ image | image_url: width: 1600 | image_tag: loading: 'lazy', alt: image_alt | default: image.alt | escape }}
        {% elsif request.design_mode %}
          <div class="ai-media-grid-{{ ai_gen_id }}__placeholder">
            {{ 'image' | placeholder_svg_tag }}
            <span class="ai-media-grid-{{ ai_gen_id }}__empty-text">Add a landscape photo</span>
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Media grid",
  "settings": [
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Image spacing",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    { "type": "header", "content": "Top left image" },
    { "type": "image_picker", "id": "image_1", "label": "Photo" },
    { "type": "text", "id": "image_1_alt", "label": "Alt text" },
    { "type": "header", "content": "Top right image" },
    { "type": "image_picker", "id": "image_2", "label": "Photo" },
    { "type": "text", "id": "image_2_alt", "label": "Alt text" },
    { "type": "header", "content": "Bottom left image" },
    { "type": "image_picker", "id": "image_3", "label": "Photo" },
    { "type": "text", "id": "image_3_alt", "label": "Alt text" },
    { "type": "header", "content": "Bottom right image" },
    { "type": "image_picker", "id": "image_4", "label": "Photo" },
    { "type": "text", "id": "image_4_alt", "label": "Alt text" }
  ],
  "presets": [
    { "name": "Media grid" }
  ],
  "tag": null,
  "class": "media-grid-block"
}
{% endschema %}