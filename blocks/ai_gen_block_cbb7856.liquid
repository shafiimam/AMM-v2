{% doc %}
  @prompt
    Can you generate me a section that can hold 2 images side by side/ split with text , can you shrink the image size or give me the option to make the images the size I want
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-split-editorial-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
    font-family: {{ settings.text_font.family }}, sans-serif;
  }

  .ai-split-editorial__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: {{ block.settings.gap }}px;
  }

  .ai-split-editorial__item-{{ ai_gen_id }} {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .ai-split-editorial__media-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.image_ratio }};
    overflow: hidden;
    background: #efefef;
  }

  .ai-split-editorial__media-{{ ai_gen_id }} img,
  .ai-split-editorial__media-{{ ai_gen_id }} svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: {{ block.settings.image_fit }};
  }

  .ai-split-editorial__copy-{{ ai_gen_id }} {
    padding-top: {{ block.settings.text_spacing }}px;
  }

  .ai-split-editorial__heading-{{ ai_gen_id }} {
    margin: 0 0 10px;
    color: inherit;
    font-family: {{ settings.heading_font.family }}, sans-serif;
    font-size: clamp(20px, 2.2vw, 30px);
    line-height: 1.15;
    text-transform: {{ settings.heading_text_transform }};
  }

  .ai-split-editorial__text-{{ ai_gen_id }} {
    color: inherit;
    font-size: 15px;
    line-height: 1.6;
  }

  .ai-split-editorial__text-{{ ai_gen_id }} p {
    margin: 0 0 12px;
  }

  .ai-split-editorial__text-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-split-editorial__link-{{ ai_gen_id }} {
    display: inline-block;
    margin-top: 16px;
    padding-bottom: 3px;
    color: inherit;
    border-bottom: 1px solid currentColor;
    text-decoration: none;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ai-split-editorial__link-{{ ai_gen_id }}:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  @media screen and (max-width: 749px) {
    .ai-split-editorial-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-split-editorial__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.gap | divided_by: 2 }}px;
    }
  }
{% endstyle %}

<div class="ai-split-editorial-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-split-editorial__grid-{{ ai_gen_id }}">
    {% for i in (1..2) %}
      {% liquid
        assign image_key = 'image_' | append: i
        assign heading_key = 'heading_' | append: i
        assign text_key = 'text_' | append: i
        assign link_label_key = 'link_label_' | append: i
        assign link_url_key = 'link_url_' | append: i
        assign item_image = block.settings[image_key]
        assign item_heading = block.settings[heading_key]
        assign item_text = block.settings[text_key]
        assign item_link_label = block.settings[link_label_key]
        assign item_link_url = block.settings[link_url_key]
      %}
      <article class="ai-split-editorial__item-{{ ai_gen_id }}">
        <div class="ai-split-editorial__media-{{ ai_gen_id }}">
          {% if item_image != blank %}
            <img src="{{ item_image | image_url: width: 1600 }}" alt="{{ item_image.alt | escape }}" width="{{ item_image.width }}" height="{{ item_image.height }}" loading="lazy">
          {% else %}
            <div class="ai-split-editorial__placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        <div class="ai-split-editorial__copy-{{ ai_gen_id }}">
          {% if item_heading != blank %}<h2 class="ai-split-editorial__heading-{{ ai_gen_id }}">{{ item_heading | escape }}</h2>{% endif %}
          {% if item_text != blank %}<div class="ai-split-editorial__text-{{ ai_gen_id }}">{{ item_text }}</div>{% endif %}
          {% if item_link_label != blank and item_link_url != blank %}<a class="ai-split-editorial__link-{{ ai_gen_id }}" href="{{ item_link_url }}">{{ item_link_label | escape }}</a>{% endif %}
        </div>
      </article>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Split image and text",
  "settings": [
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1c1c1c" },
    { "type": "range", "id": "gap", "label": "Space between columns", "min": 0, "max": 60, "step": 5, "unit": "px", "default": 20 },
    { "type": "range", "id": "text_spacing", "label": "Space above text", "min": 0, "max": 40, "step": 5, "unit": "px", "default": 15 },
    { "type": "select", "id": "image_ratio", "label": "Image proportions", "options": [ { "value": "1 / 1", "label": "Square" }, { "value": "4 / 5", "label": "Portrait" }, { "value": "3 / 2", "label": "Landscape" }, { "value": "16 / 9", "label": "Wide" } ], "default": "4 / 5" },
    { "type": "select", "id": "image_fit", "label": "Image fit", "options": [ { "value": "cover", "label": "Fill frame" }, { "value": "contain", "label": "Show entire image" } ], "default": "cover" },
    { "type": "header", "content": "Left column" },
    { "type": "image_picker", "id": "image_1", "label": "Image" },
    { "type": "text", "id": "heading_1", "label": "Heading", "default": "Our story" },
    { "type": "richtext", "id": "text_1", "label": "Text", "default": "<p>Share a short story or introduce this part of your brand.</p>" },
    { "type": "text", "id": "link_label_1", "label": "Link label" },
    { "type": "url", "id": "link_url_1", "label": "Link" },
    { "type": "header", "content": "Right column" },
    { "type": "image_picker", "id": "image_2", "label": "Image" },
    { "type": "text", "id": "heading_2", "label": "Heading", "default": "Discover more" },
    { "type": "richtext", "id": "text_2", "label": "Text", "default": "<p>Pair editorial imagery with a second message, story, or destination.</p>" },
    { "type": "text", "id": "link_label_2", "label": "Link label" },
    { "type": "url", "id": "link_url_2", "label": "Link" }
  ],
  "presets": [{ "name": "Split image and text" }],
  "tag": null,
  "class": "split-image-text"
}
{% endschema %}