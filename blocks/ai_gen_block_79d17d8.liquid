{% doc %}
  @prompt
    can you generate a split image section that allows the sizing of the photos to be adjusted and allows text to be implemented
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-split-image-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
  }
  .ai-split-image__inner-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: minmax(0, {{ block.settings.image_one_width }}fr) minmax(0, {{ block.settings.image_two_width }}fr);
    gap: {{ block.settings.image_gap }}px;
    align-items: stretch;
  }
  .ai-split-image__media-{{ ai_gen_id }} {
    position: relative;
    min-width: 0;
    overflow: hidden;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    background: #eeeeec;
  }
  .ai-split-image__media-{{ ai_gen_id }} img,
  .ai-split-image__media-{{ ai_gen_id }} svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: {{ block.settings.image_fit }};
  }
  .ai-split-image__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
  }
  .ai-split-image__empty-{{ ai_gen_id }} {
    position: absolute;
    inset: auto 12px 12px;
    padding: 8px 12px;
    background: rgba(255, 255, 255, 0.94);
    color: #1c1c1c;
    font-size: 13px;
    text-align: center;
  }
  .ai-split-image__content-{{ ai_gen_id }} {
    padding: {{ block.settings.content_padding }}px;
    display: flex;
    flex-direction: column;
    justify-content: {{ block.settings.content_alignment }};
    align-items: {{ block.settings.text_alignment }};
    text-align: {{ block.settings.text_alignment }};
    min-width: 0;
  }
  .ai-split-image__heading-{{ ai_gen_id }} {
    margin: 0 0 16px;
    color: inherit;
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.15;
  }
  .ai-split-image__copy-{{ ai_gen_id }} {
    color: inherit;
    font-size: {{ block.settings.body_size }}px;
    line-height: 1.6;
  }
  .ai-split-image__copy-{{ ai_gen_id }} p { margin: 0 0 1em; }
  .ai-split-image__copy-{{ ai_gen_id }} p:last-child { margin-bottom: 0; }
  .ai-split-image__link-{{ ai_gen_id }} {
    display: inline-flex;
    margin-top: 22px;
    padding: 12px 20px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .ai-split-image__link-{{ ai_gen_id }}:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }
  @media screen and (max-width: 749px) {
    .ai-split-image__inner-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.image_gap_mobile }}px;
    }
    .ai-split-image__content-{{ ai_gen_id }} { padding: {{ block.settings.mobile_padding }}px; }
    .ai-split-image__heading-{{ ai_gen_id }} { font-size: {{ block.settings.mobile_heading_size }}px; }
  }
{% endstyle %}

<div class="ai-split-image-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-split-image__inner-{{ ai_gen_id }}">
    <div class="ai-split-image__media-{{ ai_gen_id }}">
      {% if block.settings.image_one != blank %}
        <img src="{{ block.settings.image_one | image_url: width: 1800 }}" alt="{{ block.settings.image_one.alt | escape }}" loading="lazy" width="{{ block.settings.image_one.width }}" height="{{ block.settings.image_one.height }}">
      {% else %}
        <div class="ai-split-image__placeholder-{{ ai_gen_id }}">{{ 'image' | placeholder_svg_tag }}<span class="ai-split-image__empty-{{ ai_gen_id }}">Add the first image</span></div>
      {% endif %}
    </div>
    <div class="ai-split-image__media-{{ ai_gen_id }}">
      {% if block.settings.image_two != blank %}
        <img src="{{ block.settings.image_two | image_url: width: 1800 }}" alt="{{ block.settings.image_two.alt | escape }}" loading="lazy" width="{{ block.settings.image_two.width }}" height="{{ block.settings.image_two.height }}">
      {% else %}
        <div class="ai-split-image__placeholder-{{ ai_gen_id }}">{{ 'image' | placeholder_svg_tag }}<span class="ai-split-image__empty-{{ ai_gen_id }}">Add the second image</span></div>
      {% endif %}
    </div>
    <div class="ai-split-image__content-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}<h2 class="ai-split-image__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>{% endif %}
      {% if block.settings.text != blank %}<div class="ai-split-image__copy-{{ ai_gen_id }}">{{ block.settings.text }}</div>{% endif %}
      {% if block.settings.button_label != blank and block.settings.button_link != blank %}<a class="ai-split-image__link-{{ ai_gen_id }}" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}</a>{% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Split image and text",
  "settings": [
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "image_one", "label": "First image" },
    { "type": "image_picker", "id": "image_two", "label": "Second image" },
    { "type": "select", "id": "image_aspect_ratio", "label": "Image proportions", "options": [{ "value": "1 / 1", "label": "Square" }, { "value": "4 / 5", "label": "Portrait" }, { "value": "3 / 2", "label": "Landscape" }], "default": "4 / 5" },
    { "type": "select", "id": "image_fit", "label": "Image fit", "options": [{ "value": "cover", "label": "Fill frame" }, { "value": "contain", "label": "Fit entire image" }], "default": "cover" },
    { "type": "range", "id": "image_one_width", "label": "First image width", "min": 1, "max": 3, "step": 1, "default": 1 },
    { "type": "range", "id": "image_two_width", "label": "Second image width", "min": 1, "max": 3, "step": 1, "default": 1 },
    { "type": "range", "id": "image_gap", "label": "Image and text spacing", "min": 0, "max": 40, "step": 5, "unit": "px", "default": 10 },
    { "type": "range", "id": "image_gap_mobile", "label": "Mobile spacing", "min": 0, "max": 40, "step": 5, "unit": "px", "default": 10 },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A closer look" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Add a short description to complement your imagery.</p>" },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "select", "id": "content_alignment", "label": "Vertical alignment", "options": [{ "value": "flex-start", "label": "Top" }, { "value": "center", "label": "Middle" }, { "value": "flex-end", "label": "Bottom" }], "default": "center" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 56, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "mobile_heading_size", "label": "Mobile heading size", "min": 18, "max": 40, "step": 2, "unit": "px", "default": 26 },
    { "type": "range", "id": "body_size", "label": "Text size", "min": 12, "max": 22, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "content_padding", "label": "Content padding", "min": 0, "max": 80, "step": 5, "unit": "px", "default": 30 },
    { "type": "range", "id": "mobile_padding", "label": "Mobile padding", "min": 0, "max": 40, "step": 5, "unit": "px", "default": 15 },
    { "type": "header", "content": "Button and colors" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Discover more" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1C1C1C" },
    { "type": "color", "id": "button_color", "label": "Button background", "default": "#1C1C1C" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#FFFFFF" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "Split image and text" }],
  "tag": null,
  "class": "split-image-text-block"
}
{% endschema %}