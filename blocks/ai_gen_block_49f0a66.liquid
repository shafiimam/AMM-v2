{% doc %}
  @prompt
    are you able to generate me a section that has the ability to display video content, along with an image as well as text/headings and description , I would like for the section to be able to display video and photo content simultaneously , I would like it to where I am able to embed/input a video file into the content like how I can load an image file. I also need the orientation to be for a vertical video file and preferably a vertical image placeholder where I am able to have text overlaying the image. I want the orientation of the section to be side by side video & image with the image space able to have text typed over it
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-image-split-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
  }

  .ai-video-image-split__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.gap }}px;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-video-image-split__video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
    background-color: {{ block.settings.video_background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
  }

  .ai-video-image-split__video-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-video-image-split__video-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
    position: relative;
  }

  .ai-video-image-split__video-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-video-image-split__video-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-video-image-split__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
  }

  .ai-video-image-split__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-video-image-split__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
    position: relative;
  }

  .ai-video-image-split__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-video-image-split__image-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-video-image-split__text-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: {{ block.settings.text_vertical_alignment }};
    align-items: {{ block.settings.text_horizontal_alignment }};
    padding: {{ block.settings.text_padding }}px;
    text-align: {{ block.settings.text_align }};
    z-index: 2;
  }

  .ai-video-image-split__overlay-background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity }};
    z-index: 1;
  }

  .ai-video-image-split__heading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 {{ block.settings.text_spacing }}px 0;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    position: relative;
    z-index: 3;
  }

  .ai-video-image-split__description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.description_size }}px;
    margin: 0;
    line-height: 1.5;
    position: relative;
    z-index: 3;
  }

  @media screen and (max-width: 749px) {
    .ai-video-image-split__container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.gap | times: 0.5 }}px;
    }

    .ai-video-image-split__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-video-image-split__description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.85 }}px;
    }

    .ai-video-image-split__text-overlay-{{ ai_gen_id }} {
      padding: {{ block.settings.text_padding | times: 0.6 }}px;
    }
  }
{% endstyle %}

<video-image-split-{{ ai_gen_id }}
  class="ai-video-image-split-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-video-image-split__container-{{ ai_gen_id }}">
    <div class="ai-video-image-split__video-wrapper-{{ ai_gen_id }}">
      {% if block.settings.video %}
        <video
          class="ai-video-image-split__video-{{ ai_gen_id }}"
          {% if block.settings.video_autoplay %}autoplay{% endif %}
          {% if block.settings.video_loop %}loop{% endif %}
          {% if block.settings.video_muted %}muted{% endif %}
          playsinline
        >
          <source src="{{ block.settings.video }}" type="video/mp4">
        </video>
      {% else %}
        <div class="ai-video-image-split__video-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-video-image-split__video-empty-state-{{ ai_gen_id }}">
            Add a video file
          </div>
        </div>
      {% endif %}
    </div>

    <div class="ai-video-image-split__image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 1000 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          class="ai-video-image-split__image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-video-image-split__image-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-video-image-split__image-empty-state-{{ ai_gen_id }}">
            Add an image
          </div>
        </div>
      {% endif %}

      {% if block.settings.show_overlay %}
        <div class="ai-video-image-split__overlay-background-{{ ai_gen_id }}"></div>
      {% endif %}

      {% if block.settings.show_text_overlay %}
        <div class="ai-video-image-split__text-overlay-{{ ai_gen_id }}">
          {% if block.settings.heading != blank %}
            <h2 class="ai-video-image-split__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
          {% endif %}
          {% if block.settings.description != blank %}
            <div class="ai-video-image-split__description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</video-image-split-{{ ai_gen_id }}>

<script>
  (function() {
    class VideoImageSplit{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.video = this.querySelector('.ai-video-image-split__video-{{ ai_gen_id }}');
        if (this.video) {
          this.setupVideoControls();
        }
      }

      setupVideoControls() {
        this.video.addEventListener('click', () => {
          if (this.video.paused) {
            this.video.play();
          } else {
            this.video.pause();
          }
        });
      }
    }

    customElements.define('video-image-split-{{ ai_gen_id }}', VideoImageSplit{{ ai_gen_id }});
  })();
</script>

